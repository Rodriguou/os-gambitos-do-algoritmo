# Stockfish binary path (leave as "stockfish" if it is on the PATH)
STOCKFISH_PATH=stockfish
STOCKFISH_POOL_SIZE=4

# Search defaults
DEFAULT_DEPTH=18
# Safety watchdog (ms) for the engine; the depth is the real search bound.
DEFAULT_MAX_TIME_MS=3000
DEFAULT_MULTI_PV=3

# Advantage bar: shallower and faster than the didactic analysis
POSITION_EVAL_DEPTH=12

# Explainer: "rule" (free, deterministic) or "llm" (Azure OpenAI)
EXPLAINER_DEFAULT_MODE=rule
CACHE_MAX_SIZE=512

# Azure OpenAI (the LLM explainer is enabled only when all three are set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Keep a single failure fast: the rule explainer is the fallback.
AZURE_OPENAI_TIMEOUT_S=20
AZURE_OPENAI_MAX_RETRIES=0

# CORS
CORS_ORIGINS=["*"]
